{
  "name": "musicsmx",
  "version": "1.2.6",
  "description": "MusicSMX - 本地音乐播放器（Electron + 原生前端，无框架）",
  "main": "src/main.js",
  "author": "Sunman & SMX",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "check:radios": "node scripts/check-radios.js",
    "gen:icon": "node scripts/gen-icon.js",
    "gen:thumbar": "node scripts/gen-thumbar-icons.js",
    "gen:testmusic": "node scripts/gen-test-music.js"
  },
  "dependencies": {
    "hls.js": "^1.7.1",
    "music-metadata": "^11.15.0"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.musicsmx.player",
    "productName": "MusicSMX",
    "directories": {
      "output": "release-v44",
      "buildResources": "build"
    },
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW",
      "ja",
      "ko",
      "en-GB",
      "de",
      "fr",
      "es",
      "ru"
    ],
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MusicSMX",
      "artifactName": "MusicSMX-${version}-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "sunmanxu",
      "repo": "MusicSMX"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sunmanxu/MusicSMX.git"
  }
}
